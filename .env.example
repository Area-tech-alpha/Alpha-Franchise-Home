# URL pública da LP, sem barra no final (domínio ainda não decidido).
NEXT_PUBLIC_SITE_URL=

# "true" só no deploy definitivo. Qualquer outro valor = noindex + robots bloqueando tudo.
NEXT_PUBLIC_ALLOW_INDEXING=

# Destino do lead (lib/lead-destination.ts): "crm" ou "webhook".
# Vazio ou outro valor = o form mostra erro (o lead não é descartado em silêncio).
LEAD_DESTINATION=

# --- LEAD_DESTINATION=crm ---
# CRM comercial (Dashboard-Comercial-Back-V2): POST {CRM_API_URL}/external/leads
# com x-api-key, source "alpha-franchise" (lib/crm.ts).
CRM_API_URL=
# Chave da entrada de leads do CRM (LEAD_INTAKE_FRANCHISE_KEY). O lead vai para
# {CRM_API_URL}/external/lead-intake/franchise/franquia e entra na Comercial Franquias.
CRM_LEAD_INTAKE_KEY=

# --- LEAD_DESTINATION=webhook ---
# Recebe o JSON do lead (dados + UTMs + fbclid + landing_page + referrer + enviado_em).
# Fica só no servidor; nunca vai para o navegador.
# Na virada para o CRM: {CRM}/external/lead-intake/franchise/franquia
LEAD_WEBHOOK_URL=
# Chave da entrada de leads do CRM (LEAD_INTAKE_FRANCHISE_KEY), header x-api-key.
# Vale também para o material. Vazia = sem header (webhook do n8n).
LEAD_WEBHOOK_KEY=

# --- LP /material-geracao-de-demanda ---
# Webhook do n8n: ÚNICO destino do lead do material (não vai pro CRM nem
# depende de LEAD_DESTINATION; lib/material.ts). Só servidor. Vazia = o form
# mostra "tente de novo". A URL real fica só no .env.local e
# na Vercel (Sensitive); nunca em código, teste ou commit.
LEAD_WEBHOOK_URL_MATERIAL=

# Opcional: rate limit do form (lib/rate-limit.ts). Vazio = sem rate limit.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
